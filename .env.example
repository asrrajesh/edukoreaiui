# MySchool Local Development Configuration
# This file contains local settings for development
# DO NOT COMMIT THIS FILE - It's in .gitignore for a reason

# ─────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────

MONGO_URI=mongodb://localhost:27017/
DB_NAME=myschool
DB_CONNECTION_TIMEOUT=5000


# ─────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────

APP_TITLE=MySchool
APP_VERSION=1.0.0
THEME_COLOR=#3949AB
SECONDARY_COLOR=#5C6BC0


# ─────────────────────────────────────────────────────────────────────
# WINDOW CONFIGURATION
# ─────────────────────────────────────────────────────────────────────

WINDOW_WIDTH=400
WINDOW_HEIGHT=700
WINDOW_RESIZABLE=true
BACKGROUND_COLOR=#F5F5F5


# ─────────────────────────────────────────────────────────────────────
# SECURITY SETTINGS
# ─────────────────────────────────────────────────────────────────────

PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=0
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15


# ─────────────────────────────────────────────────────────────────────
# VALIDATION SETTINGS
# ─────────────────────────────────────────────────────────────────────

EMAIL_PATTERN=^[\w\.\+\-]+@[\w\-]+\.[a-zA-Z]{2,}$
MOBILE_PATTERN=^\+?[0-9]{10,15}$
MOBILE_MIN_LENGTH=10
MOBILE_MAX_LENGTH=15


# ─────────────────────────────────────────────────────────────────────
# API ENDPOINTS
# ─────────────────────────────────────────────────────────────────────

API_BASE_URL=http://localhost:8000
PASSWORD_RESET_SERVICE=http://localhost:8000/api/reset-password
EMAIL_SERVICE_ENABLED=false
EMAIL_SERVICE_URL=http://localhost:3000/api/send-email
SMS_SERVICE_ENABLED=false
SMS_SERVICE_URL=http://localhost:3000/api/send-sms


# ─────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────

ENABLE_PASSWORD_RESET_EMAIL=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_USER_REGISTRATION=true
ENABLE_GUEST_ACCESS=false
ENABLE_SOCIAL_LOGIN=false


# ─────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ─────────────────────────────────────────────────────────────────────

LOG_LEVEL=DEBUG
LOG_TO_FILE=false
LOG_TO_CONSOLE=true
LOG_FILE_PATH=logs/myschool.log


# ─────────────────────────────────────────────────────────────────────
# ENVIRONMENT SPECIFIC SETTINGS
# ─────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
DEBUG=true
ALLOW_CORS=true
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*